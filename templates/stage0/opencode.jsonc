// ============================================================
// opencode.jsonc - 0단계 권한 설정 (HTML·CSS 프로젝트용)
//
// 4장에서 프로젝트 맨 위 폴더로 복사합니다.
// 규칙(AGENTS.md)은 "부탁", 이 파일은 "잠금장치"입니다.
//
// 읽는 법
//   action   : 무엇을 하려는가 (shell = 명령 실행, edit = 파일 고치기, read = 파일 읽기)
//   resource : 무엇에 대해서인가 (* 는 "아무 글자나")
//   effect   : allow(그냥 허용) / ask(나에게 묻기) / deny(금지)
//
// 위에서 아래로 읽으며, 여러 규칙에 걸리면 가장 아래 규칙이 이깁니다.
// ============================================================
{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/anthropic/claude-haiku-5.5#medium",
  "share": "disabled",

  "permissions": [
    // ---------- 1. 명령 실행 ----------
    // 기본: 모든 명령은 실행 전에 나에게 묻는다.
    { "action": "shell", "resource": "*", "effect": "ask" },
    // 파일 목록과 Git 상태 확인은 묻지 않는다.
    { "action": "shell", "resource": "dir *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    // 저장과 올리기는 사람만 한다.
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },

    // ---------- 2. 파일 고치기 ----------
    // 규칙, 권한, 체크리스트(기준)는 AI 가 고치지 못한다.
    { "action": "edit", "resource": "*AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "*opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": "*CHECKLIST.md", "effect": "deny" },
    { "action": "edit", "resource": "*REQUIREMENTS.md", "effect": "deny" },

    // ---------- 3. 인터넷과 비밀 값 ----------
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" }
  ]
}
