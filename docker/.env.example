# ============================================================
# .env.example - 도커 실행 설정 견본
#
# 사용법: 이 파일을 복사해 .env 라는 이름으로 만들고 값을 채운다.
#   PowerShell>  Copy-Item .env.example .env
#
# .env 는 Git 에 올라가지 않는다(.gitignore). 이 견본에는 비밀 값을 적지 않는다.
# OpenRouter 키는 여기 적지 않는다. 컨테이너 안에서 opencode 의 /connect 로 넣는다.
# ============================================================

# 작업 폴더 (Windows 경로, / 로 쓴다). 교안의 C:\harness-lab 과 같다.
HARNESS_LAB_DIR=C:/harness-lab

# 교안 저장소 폴더 (git clone 한 위치)
TUTORIAL_DIR=C:/harness-beginner-tutorial

# Git 커밋에 남을 이름과 메일 (본인 것으로 바꾼다)
GIT_NAME="본인 이름"
GIT_EMAIL="본인 메일"
